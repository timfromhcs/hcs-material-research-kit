{
  "name": "@hcs-materials/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Tauri 2 desktop shell for the HCS Material Research Kit.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm --prefix ../.. run build -w @hcs-materials/web && tauri build",
    "build:debug": "npm --prefix ../.. run build -w @hcs-materials/web && tauri build --debug",
    "dev": "npm --prefix ../.. run build -w @hcs-materials/web && tauri dev",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}
