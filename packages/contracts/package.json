{
  "name": "@hcs-materials/contracts",
  "version": "0.2.0",
  "description": "Canonical JSON Schema contracts and runtime validators for the HCS Material Research Kit.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "node ../../scripts/sync-schemas.mjs && tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/sync-schemas.mjs && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
