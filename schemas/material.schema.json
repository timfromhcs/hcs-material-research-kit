{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hcs-materials.local/material/1.0.0",
  "title": "MaterialRecord",
  "description": "Lightweight material identity plus property claims, each with its own provenance reference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "material_id",
    "display_name",
    "formula_reduced",
    "elements",
    "structure_ref",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "material_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "formula_reduced": { "type": "string", "minLength": 1 },
    "elements": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "composition": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "structure_ref": { "type": "string", "minLength": 1 },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "record_id", "uri"],
        "properties": {
          "provider": { "type": "string" },
          "record_id": { "type": "string" },
          "uri": { "type": "string" },
          "license": { "type": "string" },
          "retrieved_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit", "method", "provenance_ref"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "conditions": { "type": "object" },
          "method": { "type": "string" },
          "fidelity_level": { "type": "string" },
          "provenance_ref": { "type": "string" },
          "uncertainty": { "type": "number" },
          "source": { "enum": ["computed", "database", "experiment", "literature", "user_estimate"] }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
